{
  "name": "@culpritsql/ci",
  "version": "0.5.13",
  "description": "SQL migration linter, query anti-pattern analyzer, execution plan regression gate, SARIF 2.1.0 emitter, and PR diff commenter powered by @culpritsql/plans WebAssembly.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "culprit-ci": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js && node -e \"import('node:fs').then((fs) => fs.chmodSync('dist/cli.js', 0o755))\"",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/culpritsql/culprit-ci.git"
  },
  "homepage": "https://explain.culpritsql.com",
  "bugs": {
    "url": "https://github.com/culpritsql/culprit-ci/issues"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@culpritsql/plans": "^0.6.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.4",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "sql",
    "linter",
    "migrations",
    "database",
    "ci",
    "github-actions",
    "sarif",
    "execution-plan",
    "explain",
    "postgres",
    "postgresql",
    "mssql",
    "sql-server",
    "mysql",
    "sqlite"
  ]
}
